# ============================================================
# PAKISTAN LEGAL AI - PRODUCTION ENVIRONMENT (Vercel + Supabase)
# ============================================================

# Server
NODE_ENV=production
PORT=3000
API_VERSION=v1

# ============================================================
# SUPABASE DATABASE CONFIGURATION
# ============================================================
# Get these from your Supabase project settings:
# https://app.supabase.com/project/[YOUR_PROJECT_ID]/settings/database
# 
# Connection String: postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
DATABASE_URL=postgresql://postgres:[YOUR_SUPABASE_PASSWORD]@[YOUR_SUPABASE_HOST]:5432/postgres?sslmode=require
DB_HOST=[YOUR_SUPABASE_HOST]
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=[YOUR_SUPABASE_PASSWORD]
DB_SSL=true
DB_POOL_MIN=1
DB_POOL_MAX=3

# JWT Configuration
JWT_SECRET=[GENERATE_A_RANDOM_32_CHAR_STRING_HERE]
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=[GENERATE_ANOTHER_RANDOM_32_CHAR_STRING_HERE]
JWT_REFRESH_EXPIRES_IN=30d

# ============================================================
# AI MODELS (Choose One or More)
# ============================================================

# Google Gemini (FREE tier recommended for Vercel)
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=[YOUR_GEMINI_API_KEY]
GEMINI_MODEL=gemini-2.0-flash

# OpenAI (for embeddings only)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=[YOUR_OPENAI_API_KEY]
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic Claude (optional, backup AI model)
ANTHROPIC_API_KEY=[YOUR_ANTHROPIC_API_KEY]
CLAUDE_MODEL=claude-3-5-sonnet-20241022
CLAUDE_MAX_TOKENS=4096

# ============================================================
# FILE UPLOAD (Using Supabase Storage)
# ============================================================
# Supabase Storage: https://app.supabase.com/project/[YOUR_PROJECT_ID]/storage/buckets
SUPABASE_URL=https://[YOUR_SUPABASE_PROJECT_ID].supabase.co
SUPABASE_ANON_KEY=[YOUR_SUPABASE_ANON_KEY]
SUPABASE_SERVICE_ROLE_KEY=[YOUR_SUPABASE_SERVICE_ROLE_KEY]
SUPABASE_STORAGE_BUCKET=legal-documents

UPLOAD_DIR=/tmp/uploads
MAX_FILE_SIZE=50mb
ALLOWED_FILE_TYPES=pdf,png,jpg,jpeg,tiff,docx,doc
ENCRYPTION_KEY=[GENERATE_A_32_CHAR_ENCRYPTION_KEY_HERE]

# ============================================================
# OCR Configuration (Tesseract)
# ============================================================
OCR_PROVIDER=tesseract
TESSERACT_PATH=/usr/bin/tesseract
TESSERACT_LANG=eng+urd

# ============================================================
# EMAIL (Optional - SMTP)
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=[YOUR_EMAIL@gmail.com]
SMTP_PASS=[YOUR_APP_PASSWORD]
EMAIL_FROM=Pakistan Legal AI <noreply@legalpk.ai>

# ============================================================
# REDIS (Optional - using Upstash Redis for Vercel)
# ============================================================
# Get Redis URL: https://console.upstash.com/redis
REDIS_URL=[YOUR_UPSTASH_REDIS_URL]
REDIS_PASSWORD=[YOUR_UPSTASH_PASSWORD]

# ============================================================
# RATE LIMITING & SECURITY
# ============================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
BCRYPT_ROUNDS=12
SESSION_SECRET=[GENERATE_A_RANDOM_SESSION_SECRET]
COOKIE_SECURE=true
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=strict

# ============================================================
# CORS Configuration
# ============================================================
CORS_ORIGIN=https://pakistan-legal-ai.vercel.app,https://yourdomain.com
CORS_CREDENTIALS=true

# ============================================================
# API & Frontend URLs
# ============================================================
FRONTEND_URL=https://pakistan-legal-ai.vercel.app
BACKEND_URL=https://pakistan-legal-ai-backend.vercel.app

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=info
LOG_FILE=/tmp/app.log

# ============================================================
# Admin Configuration
# ============================================================
ADMIN_EMAIL=admin@legalpk.ai
ADMIN_SECRET_KEY=[GENERATE_RANDOM_ADMIN_SECRET]

# ============================================================
# Vercel Specific
# ============================================================
VERCEL_ENV=production
VERCEL_URL=https://pakistan-legal-ai.vercel.app
